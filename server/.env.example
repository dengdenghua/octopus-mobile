# 复制为 .env 并按需修改;未设置的项走 mock,本地可直接跑通整条链路。

# ── 平台大模型上游(key 只在服务端,App 永远看不到)。支持多上游,按模型 provider 路由 ──
MIMO_API_KEY=
MIMO_BASE_URL=          # OpenAI 兼容 base,例: https://api.example.com/v1
# 第二上游 Agnes(对平台免费额度;作默认档省成本,仍按倍率向用户计费)
AGNES_API_KEY=
AGNES_BASE_URL=         # 例: https://apihub.agnes-ai.com/v1
DEFAULT_MODEL=agnes-2.0-flash   # 请求未指定/目录外模型时回退;默认走对平台零成本的 agnes
# 本地联调放开 mock 验证码(默认关)。公网千万别开:mock 固定码会被用来无限造号薅免费积分。
ALLOW_MOCK_AUTH=0

# ── 计费 ──
CREDITS_PER_1K_TOKENS=1   # 每 1k tokens(输入+输出)× 模型 multiplier 扣多少积分。
                          # 校准:≥ MiMo每1k_token的¥成本 ÷ (mult × 每积分售价¥)。默认 1 保守不亏,
                          # 拿到 MiMo 报价后按此式下调到贴近成本(越小=每积分能用越多 token)。
MAX_OUTPUT_TOKENS=8192    # 单次输出 token 上限(成本/防跑飞);请求里更大的会被压到此值。思考型别设太小
SIGNUP_BONUS=100          # 新用户注册送
DAILY_BONUS=20            # 每日签到送
MEMBERSHIP_DAYS=30        # 会员一次充值的有效天数
MEMBER_MAX_DAYS=365       # 会员总天数上限(防 mock 模式或异常重复续费导致会员期无限增长)

# ── 短信(留 mock=验证码固定 SMS_MOCK_CODE;生产接阿里云/腾讯云实现 send_sms()) ──
SMS_PROVIDER=mock
SMS_MOCK_CODE=123456

# ── 邮箱验证码(mock=固定 EMAIL_MOCK_CODE;生产 EMAIL_PROVIDER=smtp) ──
EMAIL_PROVIDER=mock
EMAIL_MOCK_CODE=123456
# 126/163 邮箱用 465 SSL;SMTP_PASS 填邮箱授权码,不要填网页登录密码。
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.126.com
# SMTP_PORT=465
# SMTP_USER=octoapk@126.com
# SMTP_PASS=
# SMTP_FROM=octoapk@126.com

# ── 支付(mock=查单即视为已支付;生产接 stripe/微信/支付宝,用 /billing/webhook 验签改单) ──
PAYMENT_PROVIDER=mock          # mock | stripe | wechat | alipay
# Stripe(国际卡,建议下单 currency=USD)。Dashboard → Developers:
#   1) 拿 Secret key 填 STRIPE_SECRET_KEY;
#   2) Webhooks 加端点 https://你的域名/billing/webhook/stripe,订阅 checkout.session.completed,
#      把该端点的 signing secret(whsec_...)填 STRIPE_WEBHOOK_SECRET。
STRIPE_SECRET_KEY=             # sk_live_... 或 sk_test_...
STRIPE_WEBHOOK_SECRET=         # whsec_...
STRIPE_SUCCESS_URL=https://api.octoapk.com/pay/success
STRIPE_CANCEL_URL=https://api.octoapk.com/pay/cancel

# ── 会话(JWT HS256)──
# 生产环境(ENV=production)必须设置,否则启动将拒绝;
# 留空则非生产环境自动生成一次性随机密钥
JWT_SECRET=
JWT_EXPIRE_SECONDS=2592000             # 30 天
# 设备 token HMAC 密钥:与 JWT_SECRET 分离,避免 JWT_SECRET 泄漏时可同时伪造设备 token。
# 留空则回退到 JWT_SECRET(向后兼容);生产建议设为独立随机值: python -c "import secrets; print(secrets.token_urlsafe(48))"
DEVICE_TOKEN_SECRET=

# ── 管理后台 /admin(留空=关闭,所有 /admin/api/* 返回 503,/admin 页面 404)──
# 启用务必用强随机口令: openssl rand -hex 32  (公网后台唯一防线,能改积分/封号/赠会员)
ADMIN_TOKEN=
# 可选第二道防线:只允许这些来源 IP 访问后台(逗号分隔;留空=仅靠 ADMIN_TOKEN)。
# 建议同时在 nginx 给 location /admin 加 allow/deny。
ADMIN_IP_ALLOWLIST=
# app 与公网之间的可信反代跳数(nginx 反代=1;无反代直连=0)。决定从 X-Forwarded-For
# 右数第几个是真实客户端 IP——限流/IP 白名单都依赖它,设错会让限流可被伪造 XFF 绕过。
TRUSTED_PROXIES=1

# ── 模型目录(可选,JSON 覆盖默认;每个 multiplier = 该模型的积分扣费倍率)──
# MODELS_JSON=[{"id":"mimo-v2-flash","display_name":"MiMo Flash","multiplier":0.2,"recommended":true},{"id":"mimo-v2.5-pro","display_name":"MiMo Pro","multiplier":1.0,"recommended":true}]

# ── 存储 ──
OCTO_DB=./octo.db
