# 复制为 .env 并按需修改;未设置的项走 mock,本地可直接跑通整条链路。

# ── 平台大模型(小米 MiMo)—— 只在服务端持有,App 永远看不到 ──
MIMO_API_KEY=
MIMO_BASE_URL=          # OpenAI 兼容 base,例: https://api.example.com/v1
MIMO_DEFAULT_MODEL=mimo-v2-flash

# ── 计费 ──
CREDITS_PER_1K_TOKENS=1   # 每 1k tokens(输入+输出)× 模型 multiplier 扣多少积分。
                          # 校准:≥ MiMo每1k_token的¥成本 ÷ (mult × 每积分售价¥)。默认 1 保守不亏,
                          # 拿到 MiMo 报价后按此式下调到贴近成本(越小=每积分能用越多 token)。
MAX_OUTPUT_TOKENS=8192    # 单次输出 token 上限(成本/防跑飞);请求里更大的会被压到此值。思考型别设太小
SIGNUP_BONUS=100          # 新用户注册送
DAILY_BONUS=20            # 每日签到送
MEMBERSHIP_DAYS=30        # 会员一次充值的有效天数

# ── 短信(留 mock=验证码固定 SMS_MOCK_CODE;生产接阿里云/腾讯云实现 send_sms()) ──
SMS_PROVIDER=mock
SMS_MOCK_CODE=123456

# ── 支付(mock=查单即视为已支付;生产接微信/支付宝,用 /billing/webhook 验签改单) ──
PAYMENT_PROVIDER=mock

# ── 会话(JWT HS256)──
JWT_SECRET=dev-insecure-change-me      # 生产务必改成随机长串(openssl rand -hex 32)
JWT_EXPIRE_SECONDS=2592000             # 30 天

# ── 管理后台 /admin(留空=关闭,所有 /admin/api/* 返回 503,/admin 页面 404)──
# 启用务必用强随机口令: openssl rand -hex 32  (公网后台唯一防线,能改积分/封号/赠会员)
ADMIN_TOKEN=
# 可选第二道防线:只允许这些来源 IP 访问后台(逗号分隔;留空=仅靠 ADMIN_TOKEN)。
# 建议同时在 nginx 给 location /admin 加 allow/deny。
ADMIN_IP_ALLOWLIST=
# app 与公网之间的可信反代跳数(nginx 反代=1;无反代直连=0)。决定从 X-Forwarded-For
# 右数第几个是真实客户端 IP——限流/IP 白名单都依赖它,设错会让限流可被伪造 XFF 绕过。
TRUSTED_PROXIES=1

# ── 模型目录(可选,JSON 覆盖默认;每个 multiplier = 该模型的积分扣费倍率)──
# MODELS_JSON=[{"id":"mimo-v2-flash","display_name":"MiMo Flash","multiplier":0.2,"recommended":true},{"id":"mimo-v2.5-pro","display_name":"MiMo Pro","multiplier":1.0,"recommended":true}]

# ── 存储 ──
OCTO_DB=./octo.db
