<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV 启动器 banner(320×180):深底 #111827 + 居中 app 图标。
     ic_launcher_background 颜色 / ic_launcher_foreground mipmap 不存在,
     改用 @drawable/ic_launcher 矢量图居中。minSdk=28 支持 item width/height。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#111827"/>
    </item>
    <item
        android:drawable="@drawable/ic_launcher"
        android:gravity="center"
        android:width="108dp"
        android:height="108dp"/>
</layer-list>
