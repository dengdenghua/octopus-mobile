    <!-- Guide -->
    <string name="guide_page_title">Permission Setup</string>
    <string name="guide_page_subtitle">Please enable the following permissions for the app to work properly</string>
    <string name="guide_skip">Skip</string>
    <string name="guide_start">Get Started</string>
    <string name="guide_title_accessibility">Accessibility Service</string>
    <string name="guide_desc_accessibility">This is the core permission for AI to control your device.

1. Go to Settings → Accessibility → Downloaded apps
2. Find \"Octopus Mobile\" in the list
3. Turn on the switch
4. Confirm in the system dialog</string>
    <string name="guide_title_notification">Persistent Notification</string>
    <string name="guide_desc_notification">Keeps the app running in the background to prevent it from being killed by the system.\n\nJust tap the card on the home screen to enable it. Android 13+ will ask for notification permission first.</string>
    <string name="guide_title_overlay">System Overlay</string>
    <string name="guide_desc_overlay">Displays a floating panel showing AI execution status.

1. Go to Settings → Apps → Octopus Mobile
2. Find \"Display over other apps\"
3. Turn on the switch</string>
    <string name="guide_title_battery">Battery Whitelist</string>
    <string name="guide_desc_battery">Prevents the system from stopping the app in the background.\n\nTap the card on the home screen, then confirm \"Allow\" in the system dialog. (Some devices may require setting to \"Unrestricted\")</string>
    <string name="guide_title_storage">File Access</string>
    <string name="guide_desc_storage">Allows the AI to read and write files on your device.\n\nAndroid 11+: Go to Settings → enable \"All files access\"\nAndroid 10 and below: Grant permission in the popup dialog</string>

    <!-- Advanced (Shizuku) permission card -->
    <string name="home_card_advanced_title">Advanced Power (Optional)</string>
    <string name="home_card_advanced_subtitle">Tap protected dialogs, screenshot secure windows</string>
    <string name="advanced_dialog_title">Advanced Power via Shizuku</string>
    <string name="advanced_dialog_intro">By default the AI uses Android\'s accessibility API, which is enough for most apps. A few things it can\'t do:

• Tap permission/system dialogs (FLAG_SECURE)
• Screenshot DRM-protected screens
• Force-stop other apps, change system settings

For these, install Shizuku — a safe, open-source helper.</string>
    <string name="advanced_dialog_steps">Setup steps:\n1. Install Shizuku from Play Store or GitHub\n2. Start it via wireless debugging (Android 11+) or PC ADB — once is enough\n3. Come back here — Octopus Mobile picks it up automatically</string>
    <string name="advanced_dialog_status_ready">✓ Shizuku ready — advanced power active</string>
