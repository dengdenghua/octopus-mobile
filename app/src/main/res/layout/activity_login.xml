<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBgSecondary"
    android:orientation="vertical">

    <com.apk.claw.android.widget.CommonToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="44pt" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="16pt"
        android:paddingTop="16pt">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4pt"
                android:paddingBottom="16pt"
                android:text="@string/account_login_tip"
                android:textColor="@color/colorTextSecondary"
                android:textSize="14pt" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="10pt">

                <TextView
                    android:id="@+id/tvTabPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20pt"
                    android:paddingHorizontal="4pt"
                    android:text="@string/account_tab_phone"
                    android:textColor="@color/colorBrandPrimary"
                    android:textSize="15pt"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTabEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="4pt"
                    android:text="@string/account_tab_email"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="15pt"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorContainerBrighten"
                app:cardCornerRadius="12pt"
                app:cardElevation="1pt">

                <EditText
                    android:id="@+id/etMobile"
                    android:layout_width="match_parent"
                    android:layout_height="48pt"
                    android:background="@null"
                    android:hint="@string/account_mobile_hint"
                    android:inputType="phone"
                    android:maxLines="1"
                    android:paddingHorizontal="16pt"
                    android:singleLine="true"
                    android:textColor="@color/colorTextPrimary"
                    android:textColorHint="@color/colorTextTertiary"
                    android:textSize="15pt" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20pt"
                android:paddingHorizontal="4pt"
                android:paddingBottom="8pt"
                android:text="@string/account_code_label"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14pt"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/colorContainerBrighten"
                    app:cardCornerRadius="12pt"
                    app:cardElevation="1pt">

                    <EditText
                        android:id="@+id/etCode"
                        android:layout_width="match_parent"
                        android:layout_height="48pt"
                        android:background="@null"
                        android:hint="@string/account_code_hint"
                        android:inputType="number"
                        android:maxLines="1"
                        android:paddingHorizontal="16pt"
                        android:singleLine="true"
                        android:textColor="@color/colorTextPrimary"
                        android:textColorHint="@color/colorTextTertiary"
                        android:textSize="15pt" />
                </androidx.cardview.widget.CardView>

                <com.apk.claw.android.widget.KButton
                    android:id="@+id/btnSendCode"
                    android:layout_width="wrap_content"
                    android:layout_height="48pt"
                    android:layout_marginStart="8pt"
                    android:gravity="center"
                    android:paddingHorizontal="14pt"
                    android:text="@string/account_send_code"
                    android:textSize="14pt" />
            </LinearLayout>

            <com.apk.claw.android.widget.KButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="48pt"
                android:layout_marginTop="28pt"
                android:gravity="center"
                android:text="@string/account_login_button"
                android:textSize="16pt" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
