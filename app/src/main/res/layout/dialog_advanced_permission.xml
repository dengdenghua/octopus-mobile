<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_alert"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <!-- 标题 -->
    <TextView
        android:id="@+id/tvAdvancedTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/advanced_dialog_title"
        android:textColor="@color/colorTextPrimary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- 状态条 -->
    <TextView
        android:id="@+id/tvAdvancedStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:paddingVertical="8dp"
        android:textSize="13sp" />

    <!-- 介绍 -->
    <TextView
        android:id="@+id/tvAdvancedIntro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/advanced_dialog_intro"
        android:textColor="@color/colorTextSecondary"
        android:textSize="13sp" />

    <!-- 步骤 -->
    <TextView
        android:id="@+id/tvAdvancedSteps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/advanced_dialog_steps"
        android:textColor="@color/colorTextTertiary"
        android:textSize="13sp" />

    <!-- 主操作按钮（打开 / 安装） -->
    <com.apk.claw.android.widget.KButton
        android:id="@+id/btnAdvancedPrimary"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:textSize="15sp" />

    <!-- 次操作：了解更多 -->
    <com.apk.claw.android.widget.KButton
        android:id="@+id/btnAdvancedLearnMore"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:text="@string/advanced_action_learn_more"
        android:textSize="14sp" />

    <!-- 关闭 -->
    <com.apk.claw.android.widget.KButton
        android:id="@+id/btnAdvancedClose"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:text="@string/advanced_action_close"
        android:textSize="14sp" />

</LinearLayout>
