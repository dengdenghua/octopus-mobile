<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBgPrimary"
    android:orientation="vertical">

    <com.apk.claw.android.widget.CommonToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="44pt" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="16pt"
        android:paddingTop="16pt">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Wallet card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/colorContainerBrighten"
                app:cardCornerRadius="16pt"
                app:cardElevation="1pt">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20pt">

                    <TextView
                        android:id="@+id/tvMobile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="13pt" />

                    <TextView
                        android:id="@+id/tvMember"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4pt"
                        android:textColor="@color/colorBrandPrimary"
                        android:textSize="12pt" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12pt"
                        android:text="@string/account_credits_label"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="13pt" />

                    <TextView
                        android:id="@+id/tvCredits"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="32pt"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCreditsBreakdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4pt"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="12pt" />

                    <com.apk.claw.android.widget.KButton
                        android:id="@+id/btnDailyClaim"
                        android:layout_width="wrap_content"
                        android:layout_height="40pt"
                        android:layout_marginTop="16pt"
                        android:gravity="center"
                        android:paddingHorizontal="16pt"
                        android:text="@string/account_daily_claim"
                        android:textSize="14pt" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 对话档位:单档 qwen3.5-flash 后整段隐藏(服务端 FORCE_MODEL 锁定,UI 无需让用户选档) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24pt"
                android:paddingHorizontal="4pt"
                android:paddingBottom="4pt"
                android:text="@string/account_tier_title"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14pt"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8pt"
                android:visibility="gone"
                app:cardBackgroundColor="@color/colorContainerBrighten"
                app:cardCornerRadius="16pt"
                app:cardElevation="1pt">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16pt">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.apk.claw.android.widget.KButton
                            android:id="@+id/btnTierFast"
                            android:layout_width="0dp"
                            android:layout_height="44pt"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/account_tier_fast"
                            android:textSize="14pt" />

                        <com.apk.claw.android.widget.KButton
                            android:id="@+id/btnTierFlash"
                            android:layout_width="0dp"
                            android:layout_height="44pt"
                            android:layout_marginStart="8pt"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/account_tier_flash"
                            android:textSize="14pt" />

                        <com.apk.claw.android.widget.KButton
                            android:id="@+id/btnTierPremium"
                            android:layout_width="0dp"
                            android:layout_height="44pt"
                            android:layout_marginStart="8pt"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/account_tier_premium"
                            android:textSize="14pt" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTierHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10pt"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="12pt" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Recharge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24pt"
                android:paddingHorizontal="4pt"
                android:paddingBottom="4pt"
                android:text="@string/account_recharge_title"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14pt"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/llGoods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8pt"
                android:orientation="vertical" />

            <!-- Invite / referral -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24pt"
                android:paddingHorizontal="4pt"
                android:paddingBottom="4pt"
                android:text="@string/account_invite_title"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14pt"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8pt"
                app:cardBackgroundColor="@color/colorContainerBrighten"
                app:cardCornerRadius="16pt"
                app:cardElevation="1pt">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20pt">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/account_invite_my_code"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="13pt" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4pt"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvInviteCode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.15"
                            android:text="------"
                            android:textColor="@color/colorTextPrimary"
                            android:textSize="26pt"
                            android:textStyle="bold" />

                        <com.apk.claw.android.widget.KButton
                            android:id="@+id/btnCopyCode"
                            android:layout_width="wrap_content"
                            android:layout_height="36pt"
                            android:gravity="center"
                            android:paddingHorizontal="14pt"
                            android:text="@string/account_invite_copy"
                            android:textSize="13pt" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvInviteSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8pt"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="12pt" />

                    <!-- Redeem someone else's code (hidden once redeemed) -->
                    <LinearLayout
                        android:id="@+id/llRedeem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16pt"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etInviteCode"
                            android:layout_width="0dp"
                            android:layout_height="40pt"
                            android:layout_weight="1"
                            android:background="@color/colorBgPrimary"
                            android:hint="@string/account_invite_redeem_hint"
                            android:inputType="textCapCharacters"
                            android:maxLength="8"
                            android:paddingHorizontal="12pt"
                            android:textColor="@color/colorTextPrimary"
                            android:textColorHint="@color/colorTextSecondary"
                            android:textSize="14pt" />

                        <com.apk.claw.android.widget.KButton
                            android:id="@+id/btnRedeem"
                            android:layout_width="wrap_content"
                            android:layout_height="40pt"
                            android:layout_marginStart="10pt"
                            android:gravity="center"
                            android:paddingHorizontal="16pt"
                            android:text="@string/account_invite_redeem"
                            android:textSize="14pt" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <com.apk.claw.android.widget.KButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="48pt"
                android:layout_marginTop="28pt"
                android:layout_marginBottom="24pt"
                android:gravity="center"
                android:text="@string/account_logout"
                android:textSize="16pt"
                app:btnBackground="@color/colorContainerBrighten"
                app:btnTextColor="@color/colorTextPrimary" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
