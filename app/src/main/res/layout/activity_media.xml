<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBgPrimary"
    android:orientation="vertical"
    tools:ignore="HardcodedText">

    <com.apk.claw.android.widget.CommonToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="44pt" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="16pt"
        android:paddingTop="16pt">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="输入提示词,生成图片或视频"
                android:textColor="@color/colorTextPrimary"
                android:textSize="14pt"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10pt"
                android:background="@color/colorContainerBrighten"
                android:gravity="top|start"
                android:hint="例如:一只在花园里散步的橘猫,电影感光线"
                android:minLines="3"
                android:padding="12pt"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextSecondary"
                android:textSize="15pt" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12pt"
                android:orientation="horizontal">

                <com.apk.claw.android.widget.KButton
                    android:id="@+id/btnGenImage"
                    android:layout_width="0dp"
                    android:layout_height="46pt"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="生成图片"
                    android:textSize="15pt" />

                <com.apk.claw.android.widget.KButton
                    android:id="@+id/btnGenVideo"
                    android:layout_width="0dp"
                    android:layout_height="46pt"
                    android:layout_marginStart="10pt"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="生成视频"
                    android:textSize="15pt" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14pt"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13pt" />

            <ImageView
                android:id="@+id/ivResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12pt"
                android:adjustViewBounds="true"
                android:contentDescription="生成的图片"
                android:visibility="gone" />

            <com.apk.claw.android.widget.KButton
                android:id="@+id/btnOpenVideo"
                android:layout_width="wrap_content"
                android:layout_height="40pt"
                android:layout_marginTop="12pt"
                android:gravity="center"
                android:paddingHorizontal="16pt"
                android:text="打开视频"
                android:textSize="14pt"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16pt"
                android:layout_marginBottom="24pt"
                android:text="会员免费;非会员每张图/每个视频按积分计费。视频较慢,请耐心等待。"
                android:textColor="@color/colorTextSecondary"
                android:textSize="11pt" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
